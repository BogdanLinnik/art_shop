{% doc %}
  Add-to-cart link for a product card, shown on the price line.
  Renders the shared quick-add component (adds straight to the cart, or opens the options pop-up for
  products with several options); the brand stylesheet styles it as a text link and anchors it to the
  card's bottom-inline-end corner.

  @example
  <!-- Static block inside the product card of templates/collection.json -->
{% enddoc %}

{% liquid
  assign product = closest.product
%}

{% if product != blank and product.available %}
  <div class="arette-card-add" {{ block.shopify_attributes }}>
    {% render 'quick-add', product: product, section_id: section.id, block: block %}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.arette_card_add",
  "tag": null
}
{% endschema %}
