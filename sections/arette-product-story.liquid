{% comment %}
  Section contract.
  Product story: reads a metaobject (definition `arette_product_story`) referenced by the product
  metafield `custom.story` and renders text, two images, highlights and a quote.
  Renders nothing when the product has no story assigned.
  @example
  <!-- Product template, below the main section. See docs/product-story-metaobject.md -->
{% endcomment %}

{% liquid
  assign story = product.metafields.custom.story.value
  assign image_main = story.image.value
  assign image_second = story.image_secondary.value
  assign highlights = story.highlights.value

  if section.settings.hide_images
    assign image_main = blank
    assign image_second = blank
  endif

  assign show_quote_row = false
  if section.settings.hide_quote != true and story.quote.value != blank
    assign show_quote_row = true
  endif
  if section.settings.hide_quote != true and image_second != blank
    assign show_quote_row = true
  endif
%}

{%- if story != blank -%}
  <section
    class="
      arette-story
      arette-story--quote-{{ section.settings.quote_row_order }}
      {% if section.settings.hide_quote_mobile %}arette-story--hide-quote-mobile{% endif %}
      {% if section.settings.hide_images %}arette-story--no-images{% endif %}
      {% unless section.settings.no_margin_top %}arette-story--space-top{% endunless %}
      {% unless section.settings.no_margin_bottom %}arette-story--space-bottom{% endunless %}
      {% unless section.settings.no_space_between %}arette-story--space-between{% endunless %}
    "
    style="
      --arette-story-background: {{ section.settings.background_color }};
      --arette-story-text: {{ section.settings.text_color }};
      --arette-story-accent: {{ section.settings.accent_color }};
      --arette-story-overlay-text: {{ section.settings.overlay_text_color }};
    "
  >
    <div class="arette-story__inner arette-story__inner--image-{{ section.settings.image_position }}" data-arette-reveal-group>
      <div class="arette-story__copy" data-arette-reveal>
        {%- if story.eyebrow.value != blank -%}
          <p class="arette-story__eyebrow">{{ story.eyebrow.value | escape }}</p>
        {%- endif -%}

        {%- if story.headline.value != blank -%}
          <h2 class="arette-story__headline">{{ story.headline.value | escape }}</h2>
        {%- endif -%}

        {%- if story.body.value != blank -%}
          <div class="arette-story__body rte">{{ story.body | metafield_tag }}</div>
        {%- endif -%}

        {%- if highlights != blank -%}
          <ul class="arette-story__highlights" role="list">
            {%- for highlight in highlights -%}
              <li>{{ highlight | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if image_main != blank -%}
        <div class="arette-story__media" data-arette-reveal>
          {{
            image_main
            | image_url: width: 1400
            | image_tag:
              class: 'arette-story__image',
              widths: '480, 720, 1000, 1400',
              sizes: '(min-width: 750px) 45vw, 100vw',
              alt: image_main.alt,
              loading: 'lazy'
          }}
        </div>
      {%- endif -%}
    </div>

    {%- if show_quote_row -%}
      {%- if section.settings.quote_layout == 'overlay' and image_second != blank -%}
        {%- assign quote_row_class = 'arette-story__inner--overlay arette-story__inner--text-' | append: section.settings.quote_text_position -%}
      {%- else -%}
        {%- assign quote_row_class = 'arette-story__inner--image-' | append: section.settings.quote_image_position -%}
      {%- endif -%}
      <div class="arette-story__inner arette-story__inner--secondary {{ quote_row_class }}" data-arette-reveal-group>
        {%- if image_second != blank -%}
          <div class="arette-story__media">
            {{
              image_second
              | image_url: width: 1400
              | image_tag:
                class: 'arette-story__image',
                widths: '480, 720, 1000, 1400',
                sizes: '(min-width: 750px) 45vw, 100vw',
                alt: image_second.alt,
                loading: 'lazy'
            }}
          </div>
        {%- endif -%}

        {%- if story.quote.value != blank -%}
          <figure class="arette-story__quote" data-arette-reveal="rise">
            <blockquote>{{ story.quote.value | escape }}</blockquote>
            {%- if story.quote_attribution.value != blank -%}
              <figcaption>{{ story.quote_attribution.value | escape }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

<script
  type="module"
  src="{{ 'arette-reveal.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  /* Rows run edge to edge with no outer spacing: each image touches the section above and below it,
     and the text column carries its own padding. */
  .arette-story {
    display: grid;
    background-color: var(--arette-story-background);
    color: var(--arette-story-text);
  }

  .arette-story__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
    width: 100%;
    max-width: 66rem;
    margin-inline: auto;
  }

  /* No images: one centred column of text with a maximum width. */
  .arette-story--no-images .arette-story__inner {
    grid-template-columns: minmax(0, 1fr);
    min-height: 0;
  }

  .arette-story--no-images .arette-story__copy,
  .arette-story--no-images .arette-story__quote {
    width: 100%;
    max-width: 66rem;
    margin-inline: auto;
    padding: 4rem var(--page-margin, 1.25rem);
    text-align: center;
    align-items: center;
  }

  .arette-story--no-images .arette-story__highlights {
    justify-content: center;
  }

  /* Optional spacing, off by default: above the first row, below the last row and between the two rows. */
  .arette-story--space-top {
    padding-block-start: 4rem;
  }

  .arette-story--space-bottom {
    padding-block-end: 6rem;
  }

  .arette-story--space-between {
    gap: 3rem;
  }

  @media screen and (max-width: 749px) {
    .arette-story--hide-quote-mobile .arette-story__inner--secondary {
      display: none;
    }
  }

  /* The quote row follows the story row by default; this places it above instead. */
  .arette-story--quote-above .arette-story__inner--secondary {
    order: -1;
  }

  .arette-story__copy,
  .arette-story__quote {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    min-width: 0;
    padding: 3rem var(--page-margin, 1.25rem);
  }

  .arette-story__eyebrow {
    margin: 0;
    font-family: var(--arette-font-sub, sans-serif);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--arette-story-accent);
  }

  .arette-story .arette-story__headline {
    margin: 0;
    font-family: var(--arette-font-display, sans-serif);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--arette-story-accent);
  }

  .arette-story__body {
    font-size: 1.0625rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .arette-story__body > :first-child {
    margin-block-start: 0;
  }

  .arette-story__highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .arette-story__highlights li {
    padding: 0.5rem 0.875rem;
    border: 1px solid currentcolor;
    font-family: var(--arette-font-sub, sans-serif);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .arette-story__media {
    min-width: 0;
    min-height: 0;
    /* On mobile the image always comes before the text; desktop sets the side per row below. */
    order: -1;
  }

  .arette-story__image {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .arette-story__quote {
    margin: 0;
    align-items: flex-start;
  }

  .arette-story__quote blockquote {
    margin: 0;
    font-family: var(--arette-font-display, sans-serif);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    line-height: 1.15;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--arette-story-accent);
  }

  .arette-story__quote figcaption {
    font-family: var(--arette-font-sub, sans-serif);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Quote row as a full-width image with the quote over it, near the bottom-start corner. */
  .arette-story__inner--overlay {
    position: relative;
    align-items: end;
    min-height: 28rem;
    color: var(--arette-story-overlay-text);
  }

  .arette-story__inner--overlay .arette-story__media {
    position: absolute;
    inset: 0;
    order: 0;
  }

  .arette-story__inner--overlay .arette-story__image {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
  }

  .arette-story__inner--overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(35 31 32 / 0.6), rgb(35 31 32 / 0.05) 70%);
    pointer-events: none;
  }

  .arette-story__inner--overlay .arette-story__quote {
    position: relative;
    z-index: 1;
    justify-content: flex-end;
    max-width: 52rem;
    padding: 2.5rem var(--page-margin, 1.25rem);
  }

  .arette-story__inner--overlay .arette-story__quote blockquote {
    color: inherit;
  }

  /* Text at the top: the quote and the darkening gradient move to the top edge. */
  .arette-story__inner--text-top {
    align-items: start;
  }

  .arette-story__inner--text-top::after {
    background: linear-gradient(to bottom, rgb(35 31 32 / 0.6), rgb(35 31 32 / 0.05) 70%);
  }

  .arette-story__inner--text-top .arette-story__quote {
    justify-content: flex-start;
  }

  @media screen and (min-width: 750px) {
    .arette-story__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: 34rem;
    }

    .arette-story__copy,
    .arette-story__quote {
      padding: 4rem clamp(2rem, 5vw, 5rem);
    }

    .arette-story__image {
      position: absolute;
      inset: 0;
      aspect-ratio: auto;
    }

    .arette-story__media {
      position: relative;
    }

    .arette-story__inner--image-start .arette-story__media {
      order: -1;
    }

    .arette-story__inner--image-end .arette-story__media {
      order: 1;
    }

    .arette-story__inner--overlay {
      grid-template-columns: minmax(0, 1fr);
      min-height: 34rem;
    }

    .arette-story__inner--overlay .arette-story__media {
      position: absolute;
    }

    .arette-story__inner--overlay .arette-story__quote {
      padding: 4rem clamp(2rem, 5vw, 5rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.arette_product_story",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.arette_story_info"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.arette_image_position",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "end"
    },
    {
      "type": "checkbox",
      "id": "no_margin_top",
      "label": "t:settings.arette_no_margin_top",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "no_margin_bottom",
      "label": "t:settings.arette_no_margin_bottom",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "no_space_between",
      "label": "t:settings.arette_no_space_between",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_quote",
      "label": "t:settings.arette_hide_quote",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_images",
      "label": "t:settings.arette_hide_images",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_quote_mobile",
      "label": "t:settings.arette_hide_quote_mobile",
      "default": false
    },
    {
      "type": "select",
      "id": "quote_row_order",
      "label": "t:settings.arette_quote_row_order",
      "options": [
        { "value": "below", "label": "t:options.arette_quote_below" },
        { "value": "above", "label": "t:options.arette_quote_above" }
      ],
      "default": "below"
    },
    {
      "type": "select",
      "id": "quote_layout",
      "label": "t:settings.arette_quote_layout",
      "options": [
        { "value": "split", "label": "t:options.arette_layout_split" },
        { "value": "overlay", "label": "t:options.arette_layout_overlay" }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "quote_text_position",
      "label": "t:settings.arette_quote_text_position",
      "options": [
        { "value": "top", "label": "t:options.top" },
        { "value": "bottom", "label": "t:options.bottom" }
      ],
      "default": "bottom",
      "visible_if": "{{ section.settings.quote_layout == 'overlay' }}"
    },
    {
      "type": "select",
      "id": "quote_image_position",
      "label": "t:settings.arette_quote_image_position",
      "options": [
        { "value": "start", "label": "t:options.left" },
        { "value": "end", "label": "t:options.right" }
      ],
      "default": "start",
      "visible_if": "{{ section.settings.quote_layout == 'split' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "#f5f3ea"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#231f20"
    },
    {
      "type": "color",
      "id": "overlay_text_color",
      "label": "t:settings.arette_overlay_text_color",
      "default": "#f5f3ea",
      "visible_if": "{{ section.settings.quote_layout == 'overlay' }}"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:settings.arette_accent_color",
      "default": "#696d40"
    }
  ]
}
{% endschema %}
