{% comment %}
  Section contract.
  Centered call-to-action band: optional eyebrow, heading, text and an outlined button.
  Used twice on collection and product pages ("family tradition" and "share your history").
  @example
  <!-- Added to templates/collection.json and templates/product.json below the main section -->
{% endcomment %}

<section
  class="arette-cta"
  data-arette-reveal-group
  style="
    --arette-cta-background: {{ section.settings.background_color }};
    --arette-cta-heading: {{ section.settings.heading_color }};
    --arette-cta-text: {{ section.settings.text_color }};
    --arette-cta-padding: {{ section.settings.padding }}px;
  "
>
  <div class="arette-cta__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="arette-cta__eyebrow" data-arette-reveal>{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="arette-cta__heading" data-arette-reveal>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="arette-cta__text" data-arette-reveal>{{ section.settings.text | escape }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_url != blank -%}
      <a
        href="{{ section.settings.button_url }}"
        class="arette-cta__button"
        data-arette-reveal
        {% if section.settings.open_in_new_tab %}
          target="_blank"
          rel="noopener"
        {% endif %}
      >
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
  </div>
</section>

<script
  type="module"
  src="{{ 'arette-reveal.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  .arette-cta {
    background-color: var(--arette-cta-background);
    padding-block: var(--arette-cta-padding);
    padding-inline: var(--page-margin, 1.25rem);
    text-align: center;
  }

  .arette-cta__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 52rem;
    margin-inline: auto;
  }

  .arette-cta__eyebrow {
    margin: 0;
    font-family: var(--arette-font-sub, sans-serif);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--arette-cta-heading);
  }

  .arette-cta__heading {
    margin: 0;
    font-family: var(--arette-font-display, sans-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--arette-cta-heading);
  }

  .arette-cta__text {
    margin: 0;
    max-width: 40rem;
    font-family: var(--arette-font-sub, sans-serif);
    font-weight: 500;
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-wrap: pretty;
    color: var(--arette-cta-text);
  }

  .arette-cta__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    margin-block-start: 0.75rem;
    padding: 1rem 2rem;
    border: 1px solid var(--arette-black, #231f20);
    font-family: var(--arette-font-display, sans-serif);
    font-size: 1.125rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--arette-black, #231f20);
    transition:
      background-color var(--animation-speed, 0.2s) var(--animation-easing, ease),
      color var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .arette-cta__button:hover {
    background-color: var(--arette-black, #231f20);
    color: var(--arette-sand, #f5f3ea);
  }

  @media (prefers-reduced-motion: reduce) {
    .arette-cta__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.arette_cta",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.arette_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "header",
      "content": "t:content.arette_button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.label"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.arette_open_new_tab",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "#f5f3ea"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.arette_heading_color",
      "default": "#696d40"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "default": "#7b5221"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:settings.padding",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "t:names.arette_cta"
    }
  ]
}
{% endschema %}
