{% comment %}
  Section contract.
  "Two paths, one philosophy": a heading with text and a row of large photo panels (blocks), each with a
  title, a short description and an optional link. Used under the product list to introduce the
  Artesanal and Clásico lines.
  @example
  <!-- templates/collection.json, below the cocktail pairings -->
{% endcomment %}

<section
  class="arette-paths"
  data-arette-reveal-group
  style="
    --arette-paths-background: {{ section.settings.background_color }};
    --arette-paths-heading: {{ section.settings.heading_color }};
    --arette-paths-padding: {{ section.settings.padding }}px;
  "
>
  <div class="arette-paths__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="arette-paths__heading" data-arette-reveal>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="arette-paths__text" data-arette-reveal>{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>

  <ul class="arette-paths__grid" role="list" data-arette-reveal>
    {%- for block in section.blocks -%}
      <li class="arette-paths__panel" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{
            block.settings.image
            | image_url: width: 1600
            | image_tag:
              class: 'arette-paths__image',
              widths: '750, 1100, 1600',
              sizes: '(min-width: 750px) 50vw, 100vw',
              alt: block.settings.image.alt,
              loading: 'lazy'
          }}
        {%- endif -%}
        <div class="arette-paths__content">
          <h3 class="arette-paths__title">{{ block.settings.title | escape }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="arette-paths__description">{{ block.settings.description | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
            <a class="arette-paths__link" href="{{ block.settings.link_url }}">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>

<script
  type="module"
  src="{{ 'arette-reveal.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  .arette-paths {
    padding-block-start: var(--arette-paths-padding);
    background-color: var(--arette-paths-background);
  }

  .arette-paths__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 44rem;
    margin: 0 auto 2.5rem;
    padding-inline: var(--page-margin, 1.25rem);
    text-align: center;
  }

  .arette-paths .arette-paths__heading {
    margin: 0;
    font-family: var(--arette-font-display, sans-serif);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--arette-paths-heading);
  }

  .arette-paths__text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .arette-paths__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .arette-paths__panel {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-height: 34rem;
    overflow: hidden;
    color: var(--arette-sand, #f5f3ea);
  }

  .arette-paths__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .arette-paths__panel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(35 31 32 / 0.7), rgb(35 31 32 / 0.05) 60%);
  }

  .arette-paths__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 32rem;
    padding: 2.5rem var(--page-margin, 1.25rem);
  }

  .arette-paths__title {
    margin: 0;
    font-family: var(--arette-font-display, sans-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
  }

  .arette-paths__description {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .arette-paths__link {
    font-family: var(--arette-font-sub, sans-serif);
    font-weight: 500;
    font-size: 1.125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    color: inherit;
    transition: color 0.3s ease;
  }

  .arette-paths__link:is(:hover, :focus-visible) {
    color: var(--arette-gold, #b68841);
  }

  @media screen and (min-width: 750px) {
    .arette-paths__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .arette-paths__panel {
      min-height: 40rem;
    }

    .arette-paths__content {
      padding-inline: clamp(2rem, 4vw, 4rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.arette_two_paths",
  "blocks": [
    {
      "type": "path",
      "name": "t:names.arette_path",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:settings.image" },
        { "type": "text", "id": "title", "label": "t:settings.heading" },
        { "type": "textarea", "id": "description", "label": "t:settings.arette_description" },
        { "type": "text", "id": "link_label", "label": "t:settings.label" },
        { "type": "url", "id": "link_url", "label": "t:settings.link" }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading" },
    { "type": "textarea", "id": "text", "label": "t:settings.text" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f5f3ea" },
    { "type": "color", "id": "heading_color", "label": "t:settings.arette_heading_color", "default": "#696d40" },
    { "type": "range", "id": "padding", "label": "t:settings.padding", "min": 24, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "t:names.arette_two_paths" }]
}
{% endschema %}
