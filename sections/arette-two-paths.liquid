{% comment %}
  Section contract.
  "Two paths, one philosophy": a heading with text and a two-column mosaic of blocks. A block is either a
  photo panel (image, title, description, optional link) or a message panel (eyebrow, heading, text, button
  on a colour). Blocks fill the grid in order, row by row, and stack in the same order on mobile. Used under the product list to introduce the
  Artesanal and Clásico lines.
  @example
  <!-- templates/collection.json, below the cocktail pairings -->
{% endcomment %}

<section
  class="arette-paths"
  data-arette-reveal-group
  style="
    --arette-paths-background: {{ section.settings.background_color }};
    --arette-paths-heading: {{ section.settings.heading_color }};
    --arette-paths-padding: {{ section.settings.padding }}px;
  "
>
  <div class="arette-paths__head">
    {%- if section.settings.heading != blank -%}
      <h2 class="arette-paths__heading" data-arette-reveal>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="arette-paths__text" data-arette-reveal>{{ section.settings.text | escape }}</p>
    {%- endif -%}
  </div>

  <ul class="arette-paths__grid" role="list" data-arette-reveal>
    {%- for block in section.blocks -%}
      {%- assign mobile_order = block.settings.mobile_order -%}
      {%- if mobile_order == 0 -%}
        {%- assign mobile_order = forloop.index -%}
      {%- endif -%}
      {%- if block.type == 'message' -%}
        <li
          class="arette-paths__message"
          style="
            --arette-mobile-order: {{ mobile_order }};
            --arette-message-background: {{ block.settings.background_color }};
            --arette-message-heading: {{ block.settings.heading_color }};
            --arette-message-text: {{ block.settings.text_color }};
          "
          {{ block.shopify_attributes }}
        >
          <div class="arette-paths__message-inner">
            {%- if block.settings.eyebrow != blank -%}
              <p class="arette-paths__eyebrow">{{ block.settings.eyebrow | escape }}</p>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="arette-paths__message-heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="arette-paths__message-text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank and block.settings.button_url != blank -%}
              <a
                class="arette-paths__button"
                href="{{ block.settings.button_url }}"
                {% if block.settings.open_in_new_tab %}
                  target="_blank"
                  rel="noopener"
                {% endif %}
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </li>
      {%- else -%}
        <li class="arette-paths__panel{% if block.settings.text_align == 'end' %} arette-paths__panel--text-end{% endif %}" style="--arette-mobile-order: {{ mobile_order }};" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1600
              | image_tag:
                class: 'arette-paths__image',
                widths: '750, 1100, 1600',
                sizes: '(min-width: 750px) 50vw, 100vw',
                alt: block.settings.image.alt,
                loading: 'lazy'
            }}
          {%- endif -%}
          <div class="arette-paths__content">
            <h3 class="arette-paths__title">{{ block.settings.title | escape }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="arette-paths__description">{{ block.settings.description | escape }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank and block.settings.link_url != blank -%}
              <a class="arette-paths__link" href="{{ block.settings.link_url }}">{{ block.settings.link_label | escape }}</a>
            {%- endif -%}
          </div>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>

<script
  type="module"
  src="{{ 'arette-reveal.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  .arette-paths {
    padding-block-start: var(--arette-paths-padding);
    background-color: var(--arette-paths-background);
  }

  .arette-paths__head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 44rem;
    margin: 0 auto 10rem;
    padding-inline: var(--page-margin, 1.25rem);
    text-align: center;
  }

  .arette-paths .arette-paths__heading {
    margin: 0;
    font-family: var(--arette-font-display, sans-serif);
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--arette-paths-heading);
  }

  .arette-paths__text {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .arette-paths__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .arette-paths__panel {
    position: relative;
    display: flex;
    align-items: flex-start;
    min-height: 34rem;
    overflow: hidden;
    color: var(--arette-sand, #f5f3ea);
  }

  .arette-paths__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .arette-paths__panel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(35 31 32 / 0.7), rgb(35 31 32 / 0.05) 60%);
  }

  .arette-paths__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    max-width: 32rem;
    padding: 2.5rem var(--page-margin, 1.25rem);
  }

  .arette-paths__title {
    margin: 0;
    font-family: var(--arette-font-display, sans-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: inherit;
  }

  .arette-paths__description {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .arette-paths__link {
    font-family: var(--arette-font-sub, sans-serif);
    font-weight: 500;
    font-size: 1.125rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    color: inherit;
    transition: color 0.3s ease;
  }

  .arette-paths__link:is(:hover, :focus-visible) {
    color: var(--arette-gold, #b68841);
  }

  /* On mobile the blocks stack in the order given by each block's "Mobile position" setting. */
  @media screen and (max-width: 749px) {
    .arette-paths__message,
    .arette-paths__panel {
      order: var(--arette-mobile-order, 0);
    }
  }

  .arette-paths__message {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 30rem;
    padding: 3rem var(--page-margin, 1.25rem);
    background-color: var(--arette-message-background);
    text-align: center;
  }

  .arette-paths__message-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    max-width: 36rem;
  }

  .arette-paths__eyebrow {
    margin: 0;
    font-family: var(--arette-font-sub, sans-serif);
    font-weight: 600;
    font-size: 0.9375rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--arette-message-heading);
  }

  .arette-paths .arette-paths__message-heading {
    margin: 0;
    font-family: var(--arette-font-display, sans-serif);
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--arette-message-heading);
  }

  .arette-paths__message-text {
    margin: 0;
    font-family: var(--arette-font-sub, sans-serif);
    font-weight: 500;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-wrap: pretty;
    color: var(--arette-message-text);
  }

  .arette-paths__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 1rem 2rem;
    border: 1px solid var(--arette-black, #231f20);
    font-family: var(--arette-font-display, sans-serif);
    font-size: 1.125rem;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--arette-black, #231f20);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .arette-paths__button:is(:hover, :focus-visible) {
    background-color: var(--arette-black, #231f20);
    color: var(--arette-sand, #f5f3ea);
  }

  /* Desktop and tablet: a panel can have its text aligned to the right. */
  @media screen and (min-width: 750px) {
    .arette-paths__panel--text-end {
      justify-content: flex-end;
    }

    .arette-paths__panel--text-end .arette-paths__content {
      align-items: flex-end;
      text-align: end;
    }
  }

  @media screen and (min-width: 750px) {
    .arette-paths__message,
    .arette-paths__panel {
      min-height: 40rem;
    }

    .arette-paths__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .arette-paths__panel {
      min-height: 40rem;
    }

    .arette-paths__content {
      padding-inline: clamp(2rem, 4vw, 4rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.arette_two_paths",
  "blocks": [
    {
      "type": "message",
      "name": "t:names.arette_message",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "t:settings.arette_eyebrow" },
        { "type": "text", "id": "heading", "label": "t:settings.heading" },
        { "type": "textarea", "id": "text", "label": "t:settings.text" },
        { "type": "text", "id": "button_label", "label": "t:settings.label" },
        { "type": "url", "id": "button_url", "label": "t:settings.link" },
        { "type": "checkbox", "id": "open_in_new_tab", "label": "t:settings.arette_open_new_tab", "default": true },
        { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f5f3ea" },
        { "type": "color", "id": "heading_color", "label": "t:settings.arette_heading_color", "default": "#696d40" },
        { "type": "color", "id": "text_color", "label": "t:settings.text_color", "default": "#7b5221" },
        { "type": "range", "id": "mobile_order", "label": "t:settings.arette_mobile_position", "info": "t:info.arette_mobile_position", "min": 0, "max": 8, "step": 1, "default": 0 }
      ]
    },
    {
      "type": "path",
      "name": "t:names.arette_path",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:settings.image" },
        { "type": "text", "id": "title", "label": "t:settings.heading" },
        { "type": "textarea", "id": "description", "label": "t:settings.arette_description" },
        { "type": "text", "id": "link_label", "label": "t:settings.label" },
        { "type": "url", "id": "link_url", "label": "t:settings.link" },
        { "type": "select", "id": "text_align", "label": "t:settings.arette_text_align", "info": "t:info.arette_text_align", "options": [{ "value": "start", "label": "t:options.left" }, { "value": "end", "label": "t:options.right" }], "default": "start" },
        { "type": "range", "id": "mobile_order", "label": "t:settings.arette_mobile_position", "info": "t:info.arette_mobile_position", "min": 0, "max": 8, "step": 1, "default": 0 }
      ]
    }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "t:settings.heading" },
    { "type": "textarea", "id": "text", "label": "t:settings.text" },
    { "type": "color", "id": "background_color", "label": "t:settings.background", "default": "#f5f3ea" },
    { "type": "color", "id": "heading_color", "label": "t:settings.arette_heading_color", "default": "#696d40" },
    { "type": "range", "id": "padding", "label": "t:settings.padding", "min": 24, "max": 160, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "t:names.arette_two_paths" }]
}
{% endschema %}
