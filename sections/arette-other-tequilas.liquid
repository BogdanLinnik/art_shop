{% comment %}
  Section contract.
  Product carousel ("Other tequilas" on the product page, merchandise on the collection page).
  Without a collection selected it shows the rest of the catalog, never the current product, products on
  sale first. With a collection selected it shows that collection's products in their own order.
  Products sit in an infinite carousel: three cards visible on desktop with arrow buttons,
  and both advance by themselves (no auto-advance for reduced motion).
  The "Show section" setting hides the whole section without removing it.
  Cards come from the static `static-product-card` block, so they look like the collection page cards.
  @example
  <!-- templates/product.json, below the story section -->
  <!-- templates/collection.json, below the product grid: collection "arette-artesanal", heading "Our merch" -->
{% endcomment %}

{% liquid
  assign max_products = section.settings.max_products
  assign shown = 0
  assign source_collection = section.settings.collection
  assign source_products = collections.all.products
  assign pass_count = 2
  if source_collection != blank
    assign source_products = source_collection.products
    assign pass_count = 1
  endif
%}

{% capture cards %}
  {%- for pass in (1..pass_count) -%}
    {%- for other in source_products -%}
      {%- if other.id == product.id -%}
        {%- continue -%}
      {%- endif -%}

      {%- assign on_sale = false -%}
      {%- if other.compare_at_price > other.price -%}
        {%- assign on_sale = true -%}
      {%- endif -%}

      {%- if pass_count == 2 and pass == 1 and on_sale == false -%}
        {%- continue -%}
      {%- endif -%}
      {%- if pass_count == 2 and pass == 2 and on_sale -%}
        {%- continue -%}
      {%- endif -%}
      {%- if shown >= max_products -%}
        {%- break -%}
      {%- endif -%}

      <li class="arette-others__item" data-arette-carousel-slide>
        {% content_for 'block',
          type: '_product-card',
          id: 'static-product-card',
          closest.product: other
        %}
      </li>
      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
  {%- endfor -%}
{% endcapture %}

{%- if shown > 0 and section.settings.show_section -%}
  {%- assign has_card_colors = false -%}
  {%- if section.settings.card_background_color != blank or section.settings.card_text_color != blank -%}
    {%- assign has_card_colors = true -%}
  {%- endif -%}
  <section
    class="arette-others{% if has_card_colors %} arette-others--card-colors{% endif %}"
    data-arette-reveal-group
    style="
      --arette-others-background: {{ section.settings.background_color }};
      --arette-others-heading: {{ section.settings.heading_color }};
      --arette-others-padding: {{ section.settings.padding }}px;
      {% if section.settings.card_background_color != blank %}--arette-others-card-bg: {{ section.settings.card_background_color }};{% endif %}
      {% if section.settings.card_text_color != blank %}--arette-others-card-text: {{ section.settings.card_text_color }};{% endif %}
    "
  >
    <div class="arette-others__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="arette-others__heading" data-arette-reveal>{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div
        class="arette-others__carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.heading | escape }}"
        data-arette-carousel
        data-interval="{{ section.settings.interval }}"
        data-arette-reveal
      >
        <ul class="arette-others__track product-grid" role="list" data-arette-carousel-track>
          {{ cards }}
        </ul>

        {%- if shown > 1 -%}
          <button
            type="button"
            class="arette-others__arrow arette-others__arrow--prev button-unstyled"
            data-arette-carousel-prev
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
          >
            <span class="svg-wrapper" aria-hidden="true">{{- 'icon-chevron-left.svg' | inline_asset_content -}}</span>
          </button>
          <button
            type="button"
            class="arette-others__arrow arette-others__arrow--next button-unstyled"
            data-arette-carousel-next
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
          >
            <span class="svg-wrapper" aria-hidden="true">{{- 'icon-chevron-right.svg' | inline_asset_content -}}</span>
          </button>
        {%- endif -%}

        {%- if shown > 1 -%}
          <div class="arette-others__controls">
            <div class="arette-others__dots">
              {%- for i in (1..shown) -%}
                <button
                  type="button"
                  class="arette-others__dot button-unstyled"
                  data-arette-carousel-dot="{{ forloop.index0 }}"
                  aria-label="{{ 'accessibility.slide_status' | t: index: forloop.index, length: shown }}"
                  {% if forloop.first %}
                    aria-current="true"
                  {% endif %}
                ></button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

<script
  type="module"
  src="{{ 'arette-reveal.js' | asset_url }}"
  fetchpriority="low"
></script>
<script
  type="module"
  src="{{ 'arette-carousel.js' | asset_url }}"
  fetchpriority="low"
></script>

{% stylesheet %}
  .arette-others {
    padding-block: var(--arette-others-padding);
    padding-inline: var(--page-margin, 1.25rem);
    background-color: var(--arette-others-background);
  }

  .arette-others__inner {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 70rem;
    margin-inline: auto;
  }

  .arette-others .arette-others__heading {
    margin: 0;
    font-family: var(--arette-font-display, sans-serif);
    font-size: var(--arette-size-heading, clamp(2.25rem, 4.5vw, 3.25rem));
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-align: center;
    text-transform: uppercase;
    color: var(--arette-others-heading);
  }

  .arette-others__carousel {
    position: relative;
  }

  /* A single scroll-snap row for every width; clones added by arette-carousel.js make it infinite. */
  .arette-others .arette-others__track {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .arette-others .arette-others__track::-webkit-scrollbar {
    display: none;
  }

  .arette-others__item {
    flex: 0 0 calc((100% - 3rem) / 3);
    min-width: 0;
    scroll-snap-align: start;
    /* Room for the card hover shadow, which scroll clipping would otherwise cut off. */
    padding-block: 1rem;
  }

  /* Same card box as the collection grid: a full-height grid item. */
  .arette-others__item product-card {
    display: grid;
    height: 100%;
  }

  .arette-others__controls,
  .arette-others__arrow {
    display: none;
  }

  @media screen and (min-width: 750px) {
    /* Room around the cards for the hover shadow, which the scrolling row would otherwise clip. The
       padding equals the gap between cards, so no neighbouring card shows in it, and a negative margin
       cancels it so the cards keep their place. */
    .arette-others .arette-others__track {
      margin-inline: calc(-1.5rem + 2px);
      padding-inline: calc(1.5rem - 2px);
      scroll-padding-inline: calc(1.5rem - 2px);
    }

    .arette-others__item {
      padding-block: 2rem;
    }

    .arette-others .arette-others__track {
      margin-block: -1rem;
    }

    /* Arrows match the parent site's carousel (translucent 44 x 60 blocks with a thin white chevron) and
       sit in the side gutters, outside the cards. */
    .arette-others {
      padding-inline: max(var(--page-margin, 1.25rem), 4.5rem);
    }

    .arette-others__carousel[data-arette-infinite='true'] .arette-others__arrow {
      --icon-stroke-width: 1px;

      position: absolute;
      inset-block-start: 36%;
      z-index: var(--layer-raised, 2);
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 3.75rem;
      padding: 0;
      border: 0;
      border-radius: 0;
      background-color: rgb(0 0 0 / 0.12);
      color: #fff;
      cursor: pointer;
      transition: background-color 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .arette-others__carousel[data-arette-infinite='true'] .arette-others__arrow:is(:hover, :focus-visible) {
      background-color: rgb(0 0 0 / 0.3);
    }

    .arette-others__arrow .svg-wrapper {
      width: 1.5rem;
      height: 1.5rem;
    }

    .arette-others__arrow--prev {
      inset-inline-start: -3.75rem;
    }

    .arette-others__arrow--next {
      inset-inline-end: -3.75rem;
    }

    [dir='rtl'] .arette-others__arrow .svg-wrapper {
      scale: -1 1;
    }
  }

  /* Mobile: one card at a time in a horizontal, snapping carousel. */
  @media screen and (max-width: 749px) {
    /* Full-width card: the section drops its side padding and only the heading keeps it. */
    .arette-others {
      padding-inline: 0;
      padding-block-end: 0;
    }

    .arette-others__inner {
      gap: 1.75rem;
    }

    .arette-others .arette-others__heading {
      padding-inline: var(--page-margin, 1.25rem);
    }

    /* Mobile: tighter space above the heading. */
    .arette-others {
      padding-block-start: min(var(--arette-others-padding), 2.5rem);
    }

    .arette-others .arette-others__track {
      gap: 0;
    }

    .arette-others__item {
      flex-basis: 100%;
      /* No hover shadow on mobile, so no room is needed around the card. */
      padding-block: 0;
    }

    /* The dots bar sits directly under the card, on the page background like the card. */
    .arette-others__controls {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 1rem 1.5rem;
      background-color: transparent;
    }

    .arette-others__dots {
      display: flex;
      gap: 1rem;
    }

    .arette-others__dot {
      position: relative;
      width: 0.875rem;
      height: 0.875rem;
      padding: 0;
      border: 1px solid var(--arette-brown, #7b5221);
      border-radius: 50%;
      background: transparent;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    /* Larger touch target than the visible dot. */
    .arette-others__dot::after {
      content: '';
      position: absolute;
      inset: -0.5rem;
    }

    .arette-others__dot[aria-current='true'] {
      background-color: var(--arette-brown, #7b5221);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arette-others__dot,
    .arette-others__arrow {
      transition: none;
    }
  }

  /* Optional card colors (for example light text on a dark section background): card background, name, price,
     Add link and carousel dots follow the two settings. */
  body .arette-others--card-colors .product-grid .product-card {
    background: var(--arette-others-card-bg, transparent);
  }

  body .arette-others--card-colors .product-card :is(h3, p, .price, [class*='price'], [class*='title']),
  body .arette-others--card-colors product-card .arette-card-add button.quick-add__button:is(:not(:hover), :hover, :focus-visible, :active) {
    color: var(--arette-others-card-text, inherit);
  }

  .arette-others--card-colors .arette-others__controls {
    background-color: var(--arette-others-card-bg, transparent);
  }

  .arette-others--card-colors .arette-others__dot {
    border-color: var(--arette-others-card-text, var(--arette-brown, #7b5221));
  }

  .arette-others--card-colors .arette-others__dot[aria-current='true'] {
    background-color: var(--arette-others-card-text, var(--arette-brown, #7b5221));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.arette_other_tequilas",
  "blocks": [
    {
      "type": "_product-card"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "t:settings.arette_show_section",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Other tequilas"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection",
      "info": "t:info.arette_carousel_collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "interval",
      "label": "t:settings.arette_carousel_interval",
      "min": 3,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 10
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background",
      "default": "#f5f3ea"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "t:settings.arette_heading_color",
      "default": "#696d40"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "t:settings.arette_card_background",
      "info": "t:info.arette_card_colors"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "t:settings.arette_card_text"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "t:settings.padding",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "t:names.arette_other_tequilas"
    }
  ]
}
{% endschema %}
